# -------------------------------------------------------
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env — ele já está no .gitignore.
# -------------------------------------------------------

# Supabase — encontre em: Project Settings > Database > Connection string
# Use a connection string no modo "Session" (porta 5432) para asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:<senha>@db.<ref>.supabase.co:5432/postgres

# JWT — gere uma chave segura com: openssl rand -hex 32
SECRET_KEY=troque-por-uma-chave-segura-gerada-com-openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ambiente
ENVIRONMENT=development   # development | production
